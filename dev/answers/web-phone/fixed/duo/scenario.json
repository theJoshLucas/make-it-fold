{
  "backend": "mocked",
  "paths": ["/"],
  "steps": {
    "/": [
      {"pose": "outer-portrait"},
      {"tap": "#sessions li"},
      {"expect_visible": "#d-next"},
      {"type": ["#d-next", "Half-typed note"]},
      {"name": "session open"},
      {"pose": "outer-portrait"},
      {"pose": "inner-landscape"},
      {"expect_value": ["#d-next", "Half-typed note"]},
      {"expect_visible": "#sessions"},
      {"pose": "inner-portrait"},
      {"expect_value": ["#d-next", "Half-typed note"]},
      {"pose": "book"},
      {"pose": "outer-portrait"},
      {"expect_value": ["#d-next", "Half-typed note"]},
      {"tap": "#back"},
      {"tap": "#add"},
      {"type": ["#f-piece", "Half-typed piece"]},
      {"name": "new-session form"},
      {"pose": "outer-portrait"},
      {"pose": "inner-landscape"},
      {"expect_value": ["#f-piece", "Half-typed piece"]},
      {"expect_visible": "#sheet button[type=submit]"},
      {"pose": "inner-portrait"},
      {"pose": "outer-portrait"},
      {"expect_value": ["#f-piece", "Half-typed piece"]}
    ]
  }
}
